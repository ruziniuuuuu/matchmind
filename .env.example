# ── Model provider ─────────────────────────────────────────────
# deepseek (default) | azure_openai (Azure OpenAI / Foundry resource) | foundry (Foundry project)
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_DEEP=deepseek-v4-pro

# Azure OpenAI / Foundry resource (LLM_PROVIDER=azure_openai) - simplest, key or Entra auth
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your deployment name>
# AZURE_OPENAI_API_KEY=<key>            # or leave empty + AZURE_OPENAI_USE_ENTRA=true (az login)
# AZURE_OPENAI_USE_ENTRA=false
# AZURE_OPENAI_API_VERSION=2025-04-01-preview   # gpt-5 needs a recent version
# AZURE_OPENAI_REASONING_EFFORT=minimal         # gpt-5/o-series only
# AZURE_OPENAI_BASE_URL=                # optional: https://<resource>.openai.azure.com/openai/v1/

# Optional: Microsoft Foundry production path (LLM_PROVIDER=foundry, Entra ID via az login / managed identity)
# FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-service.services.ai.azure.com/api/projects/your-project
# FOUNDRY_MODEL=gpt-5.4-mini

# ── App ────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
DEMO_MODE=replay
ALLOW_LIVE_GENERATION=true
USE_AGENT_GRAPH=true
AGENT_MAX_ATTEMPTS=2
AGENT_RETRY_DELAY_SECONDS=0.35
AGENT_MAX_CONCURRENCY=0          # set 2-3 on low-quota Azure deployments (429s)
AGENT_RATE_LIMIT_RETRIES=3
MATCH_DATA_DIR=./data/demo
AUDIT_DB_PATH=./data/audit.sqlite3
CACHE_DIR=./data/cache

# Public base URL (used for overlay/demo links; set in deployment)
PUBLIC_BASE_URL=http://localhost:8010

# ── Optional: Azure production path ────────────────────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AZURE_COSMOS_ENDPOINT=
# AZURE_COSMOS_DATABASE=matchmind
# AZURE_KEY_VAULT_URI=

# ── Safety / budget ────────────────────────────────────────────
MAX_LLM_CALLS_PER_MATCH=60
MAX_COST_USD_PER_MATCH=2.00
LIVE_RATE_LIMIT_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=60
